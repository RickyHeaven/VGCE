{
  "name": "@zhangqingcq/vgce",
  "version": "0.3.3",
  "description": "Vector graphics configure editor. svg组态编辑器。基于vue3.3+ts+element-plus+vite",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "types",
    "src/config",
    "README-EN.md"
  ],
  "main": "./dist/vgce.umd.cjs",
  "module": "./dist/vgce.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/vgce.js",
      "require": "./dist/vgce.umd.cjs"
    },
    "./config/types": "./src/config/types.ts",
    "./config/*": "./src/config/*",
    "./dist/style.css": "./dist/style.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "types": "types/index.d.ts",
  "scripts": {
    "dev": "vite",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false && tsc --noEmit -p tsconfig.node.json --composite false",
    "lib": "npm run type-check && vite build --mode lib",
    "prepublishOnly": "npm run lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RickyHeaven/VGCE.git"
  },
  "keywords": [
    "vue",
    "pinia",
    "echarts",
    "svg",
    "vector",
    "graphics",
    "editor",
    "element",
    "vite",
    "ricky",
    "zhangqingcq"
  ],
  "author": "RickyHeaven",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RickyHeaven/VGCE/issues"
  },
  "homepage": "https://github.com/RickyHeaven/VGCE#readme",
  "peerDependencies": {
    "vue": ">=3.3.4",
    "pinia": ">=2.1.3",
    "element-plus": ">=2.8.6",
    "lodash-es": ">=4.17.21",
    "ace-builds": ">=1.14.0",
    "vue-echarts": ">=6.5.1",
    "echarts": ">=5.4.1",
    "mqtt": ">=5.1.3",
    "vite-plugin-svg-icons": ">=2.0.1"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "@tsconfig/node18": "^2.0.1",
    "@types/lodash-es": "^4.17.8",
    "@types/node": "^18.16.17",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vitejs/plugin-vue-jsx": "^3.0.1",
    "@vue/tsconfig": "^0.4.0",
    "ace-builds": "1.14.0",
    "animate.css": "^4.1.1",
    "axios": "^1.4.0",
    "echarts": "^5.4.1",
    "element-plus": "2.8.6",
    "less": "^4.1.3",
    "lodash-es": "^4.17.21",
    "mqtt": "5.1.3",
    "npm-run-all": "^4.1.5",
    "pinia": "^2.1.3",
    "prettier": "3.0.0",
    "typescript": "~5.0.4",
    "unplugin-auto-import": "^0.16.6",
    "vite": "^4.3.9",
    "vite-plugin-svg-icons": "^2.0.1",
    "vite-plugin-windicss": "^1.9.0",
    "vue": "^3.3.4",
    "vue-echarts": "^6.5.1",
    "vue-router": "^4.2.2",
    "vue-tsc": "^1.6.5",
    "vue3-ace-editor": "^2.2.2",
    "windicss": "^3.5.6"
  },
  "engines": {
    "node": ">=18.16.0",
    "npm": ">=9.5.1",
    "pnpm": ">=8.6.0"
  }
}